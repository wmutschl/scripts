DOCKER_ROOT=/Volumes/Docker
TIMEZONE=Europe/Berlin
IP=192.168.178.65
# Nextcloud All-in-One (AIO) Configuration for macOS
# -------------------------------------------------
# AIO manages database, Redis, and all services internally
# No need to configure database passwords or Redis!

# Tailscale Configuration
# -----------------------
# Get TAILSCALE_OAUTH_KEY from: Tailscale Admin > Settings > OAuth Clients
# Create a new OAuth client with:
#   - Devices Core: Read and Write (add tag:container)
#   - Keys OAuth Keys: Read and Write
TAILSCALE_OAUTH_KEY=

# The hostname for your Nextcloud instance
# Will become: <hostname>.hippocampus-rockhopper.ts.net
# Example: "cloud" becomes "cloud.hippocampus-rockhopper.ts.net"
TAILSCALE_HOSTNAME=nextcloud

NEXTCLOUD_DATADIR=${DOCKER_ROOT}/nextcloud

# Minecraft Server (Java Edition)
# -------------------------------
# Reachable on the LAN at ${IP}:25565 and on the tailnet as
# <hostname>.hippocampus-rockhopper.ts.net (default port, no port needed).
MINECRAFT_TAILSCALE_HOSTNAME=minecraft

MINECRAFT_DATADIR=${DOCKER_ROOT}/minecraft/data
MINECRAFT_BACKUPDIR=${DOCKER_ROOT}/minecraft/backups

# LATEST tracks the newest release; pin it (e.g. 26.1) if your players are on
# a fixed client version, otherwise an update can lock them out. When pinning an
# older version, check that the image's java tag still matches its requirement.
# Snapshots use ids like 26.3-snapshot-5 (SNAPSHOT always takes the newest one).
MINECRAFT_VERSION=LATEST

# World directory under the data dir. Point snapshots at their own world:
# opening a world in a newer version upgrades it and there is no way back.
MINECRAFT_LEVEL=world

# Java heap, preallocated in full (Aikar's flags set -Xms == -Xmx). 4G-6G is
# plenty at default view distance; raise it if you push VIEW_DISTANCE up, since
# loaded chunks are what fills the heap. Stay well under the OrbStack VM size.
MINECRAFT_MEMORY=12G

MINECRAFT_MOTD=Mutschler Minecraft Server

# Comma-separated Minecraft usernames (no spaces), e.g. Notch,jeb_
# Leaving MINECRAFT_WHITELIST empty disables the whitelist, which means anyone
# on the LAN or on the tailnet can join.
MINECRAFT_OPS=
MINECRAFT_WHITELIST=

# Required - minecraft-backup uses RCON to flush the world before each snapshot.
# Generate with: openssl rand -base64 24
MINECRAFT_RCON_PASSWORD=
