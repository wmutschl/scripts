# Dell Wyse 5070 (hostname dell-wyse), Ubuntu Server 26.04 LTS
# Copy to .env next to docker-compose.yml and run: chmod 600 .env

# Tailscale sidecar for Nextcloud
# -------------------------------
# OAuth client secret (tskey-client-...) from Tailscale Admin > Settings > Trust credentials:
# a client of its own for the Wyse, scope auth_keys (write) with tag:nextcloud only;
# no other scope is needed, and the other machine's clients stay separate.
# If device approval is on, append &preauthorized=true to TS_AUTHKEY in docker-compose.yml, after ?ephemeral=false.
# Only needed while the sidecar has no state yet (first start, or after its state volume was lost);
# TS_AUTH_ONCE=true keeps it from being used on every restart.
# Keep a copy in the password manager.
TAILSCALE_OAUTH_KEY=

# Becomes <hostname>.<tailnet>.ts.net and is the domain AIO is set up with.
# A restored AIO backup keeps the old domain, so a restore needs exactly that name.
# Check the node's actual DNS name before entering it in AIO:
# an existing node with the same name makes Tailscale hand out nextcloud-1 instead.
TAILSCALE_HOSTNAME=nextcloud

# Serve configuration from the repository's Tailscale/ folder:
# nextcloud-funnel.json publishes Nextcloud through Funnel, the guide's default;
# nextcloud-serve.json keeps it reachable only from the tailnet and needs the host to run with --accept-dns=true
# (guide section 9.2, "Serve instead of Funnel"). On a running stack, apply a change with:
# sudo docker compose up -d nextcloud-tailscale
TAILSCALE_SERVE_CONFIG=nextcloud-funnel.json

# Nextcloud AIO
# -------------
# On the @nextcloud subvolume, mounted at /srv/nextcloud.
# Set before the first start of AIO and never change it afterwards.
NEXTCLOUD_DATADIR=/srv/nextcloud/data
