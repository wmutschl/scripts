# Dell Wyse 5070 (hostname dell-wyse): settings and secrets for the host's backup jobs.
# Copy this file once to /etc/dell-wyse/host.env (root only, mode 600).
# Fill in the values there, never in the repository, and keep a copy of the secrets in the password manager.

# healthchecks.io: Project Settings > API Access > Ping key.
# The checks are named dell-wyse-<job> and are created by their first ping.
HC_PING_KEY=

# Off-site copy on a Hetzner Storage Box, SSH (port 23), through a sub-account of its own
# that sees only its home directory, e.g. u123456-sub1@u123456.your-storagebox.de.
# Use the same host name as in guide 7.6, step 4: root's known_hosts knows the box only under that name.
# The copies land in borg/ and ha-backups/ there.
OFFSITE_TARGET=
OFFSITE_PORT=23
# Optional rsync upload limit in KiB/s for the Storage Box job, e.g. 2500 (about 20 Mbit/s)
# while its first upload runs, so Nextcloud stays usable from outside. Empty means no limit.
OFFSITE_BWLIMIT=
