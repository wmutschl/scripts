# Apple Mac mini M4 Pro (hostname mac-mini): settings of the host's launchd jobs.
# Copy this file once to ~/.config/mac-mini/host.env (mode 600) and fill in the values there, never in the repository.

# healthchecks.io: Project Settings > API Access > Ping key.
# The checks are named mac-mini-<job> and are created by their first ping.
HC_PING_KEY=

# Gitea backups (mac-mini-gitea-backup): a folder Time Machine backs up and the number of runs to keep there.
# Time Machine keeps the older runs. Not under ~/Documents, ~/Desktop or ~/Downloads: launchd jobs may not write there.
GITEA_BACKUP_DIR=$HOME/Backups/gitea
GITEA_BACKUP_KEEP=2

# Uptime check (mac-mini-alive): also checks modCraft's privacy page, which needs no password,
# e.g. https://modcraft.tailnet-name.ts.net/privacy. Leave it empty once modCraft has moved to its VPS.
MODCRAFT_CHECK_URL=
# true: resolve modCraft's name through public DNS, so the check takes the public route through Funnel;
# empty: through the tailnet, as on the Mac MagicDNS answers with the sidecar's tailnet address.
# Leave it empty with modcraft-serve.json, which has no public route.
MODCRAFT_CHECK_FUNNEL=true
