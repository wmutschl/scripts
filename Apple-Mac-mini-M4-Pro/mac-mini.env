# Apple Mac mini M4 Pro (hostname mac-mini), macOS with OrbStack
# Copy to .env next to docker-compose.yml and run: chmod 600 .env
# Keep a copy of the secrets in the password manager.

TIMEZONE=Europe/Berlin

# Tailscale sidecars of Gitea and modCraft
# ----------------------------------------
# OAuth client secret (tskey-client-...) from the Tailscale admin console > Settings > Trust credentials:
# a client of its own for the Mac mini, scope Auth Keys (write) with the tags tag:gitea and tag:container.
# If device approval is on, append &preauthorized=true to both TS_AUTHKEY lines in docker-compose.yml, after ?ephemeral=false.
# Only needed while a sidecar has no state yet (first start, or after its state volume was lost);
# TS_AUTH_ONCE=true keeps it from being used on every restart.
TAILSCALE_OAUTH_KEY=

# Gitea
# -----
# Node name of Gitea's sidecar; becomes <hostname>.<tailnet>.ts.net.
# Check the node's actual DNS name in the admin console after its first start:
# an existing node with the same name makes Tailscale hand out gitea-1 instead.
GITEA_TAILSCALE_HOSTNAME=gitea
# Exactly that DNS name: Gitea's ROOT_URL is https://GITEA_DOMAIN/, and clone URLs and SSH use it too
GITEA_DOMAIN=gitea.tailnet-name.ts.net

# PostgreSQL password of the gitea role; openssl rand -hex 24
# Used only when the database is created; changing it later also needs ALTER ROLE inside PostgreSQL.
GITEA_DB_PASSWORD=

# Generate both once, before the first start, and never change SECRET_KEY afterwards:
#   docker run --rm docker.gitea.com/gitea:28.4.0-rootless gitea generate secret SECRET_KEY
#   docker run --rm docker.gitea.com/gitea:28.4.0-rootless gitea generate secret INTERNAL_TOKEN
# Without -t, so the values end without a carriage return.
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# Registration token for the container runner, scoped to your user:
#   docker exec gitea gitea actions generate-runner-token --scope YOUR_GITEA_USERNAME
# Needed only for the first start of gitea-runner, while its /data/.runner does not exist yet.
# Empty it afterwards and reset the token in Gitea (user settings > Actions > Runners).
GITEA_RUNNER_REGISTRATION_TOKEN=

# modCraft
# --------
# The app runs from its own repository (~/modCraft/website) and publishes only 127.0.0.1:8080.
# Its own .env must list this node's DNS name, because Serve keeps the Host header:
#   MODCRAFT_SITE_ADDRESS='http://modcraft.tailnet-name.ts.net:8080, http://localhost:8080'
MODCRAFT_TAILSCALE_HOSTNAME=modcraft
# Serve configuration from the repository's Tailscale/ folder:
# modcraft-funnel.json publishes modCraft on the internet through Funnel (password-protected by modCraft's Caddy);
# modcraft-serve.json keeps it reachable only from the tailnet.
# On a running stack, apply a change with: docker compose up -d modcraft-tailscale
MODCRAFT_SERVE_CONFIG=modcraft-funnel.json
